{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/admin*", "/assets/*", "*.{png,jpg,jpeg,svg,webp,ico,css,js,map}"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "The operations console is a bundle of its own, so it is served rather than falling through to the marketplace. Its own sign-in gates it, and the API refuses every /api/admin/* call from an account that is not a configured operator - the rewrite is routing, never access control.",
      "route": "/admin*",
      "rewrite": "/admin.html"
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
