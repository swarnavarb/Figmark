{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AzureWebJobsStorage": "",

    "SITE_ENVIRONMENT": "<optional: 'development' puts a test-site banner on every page and keeps it out of search engines; 'production' or empty shows none>",

    "AUTH_MODE": "mock",
    "AUTH_SESSION_SECRET": "dev-only-change-me",

    "COSMOS_ENDPOINT": "https://cosmos-figuremarket-dev.documents.azure.com:443/",
    "COSMOS_KEY": "<primary key from: az cosmosdb keys list -n cosmos-figuremarket-dev -g rg-figuremarket-dev>",
    "COSMOS_DATABASE": "figmark",
    "COSMOS_THROUGHPUT": "<only for npm run azure:provision: 'serverless' for a serverless account; empty gives the free tier's 1000 RU/s>",

    "STORAGE_ACCOUNT": "stfiguremarketdev",
    "STORAGE_KEY": "<key from: az storage account keys list -n stfiguremarketdev -g rg-figuremarket-dev>",

    "WEB_PUSH_PUBLIC_KEY": "<from: npm run push:keys - leave both empty to keep notifications off>",
    "WEB_PUSH_PRIVATE_KEY": "<from: npm run push:keys>",
    "WEB_PUSH_SUBJECT": "mailto:you@example.com",

    "PUBLIC_ORIGIN": "<optional: comma-separated origins the site is served at, first one canonical - empty believes the request's host, which is only right on a laptop>",

    "ANTHROPIC_API_KEY": "<optional: lets photo search find an item from what is in the photo - empty matches by picture only>"
  }
}
